# Dependencies
node_modules/
.pnp
.pnp.js

# Build
dist/
build/
.next/
.nuxt/
.output/
# Vite 加载 TS 配置时现场转译出的临时文件（正常会自删，进程被杀就留下）
vite.config.ts.timestamp-*.mjs

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# AI 工具本地配置
.zcodeignore
.workbuddy/

# 存储后端运行时数据
server/data/

# 本地开发/调试日志
.tmp-*
*.log

# Windows 下 bash 的 `> nul` 会生成一个名为 nul 的真实文件，而不是丢弃输出
# （同类保留设备名 con/aux/prn/com1-9/lpt1-9 在 bash 里重定向也会建出真实文件，
#   且这些文件在本机建出来就删不掉，故一并忽略以防误入提交）
nul
con
aux
prn
com[1-9]
lpt[1-9]

# 浏览器自动化本地缓存
.playwright-cli/

# 设计沙箱的构建产物：esbuild 输出，每个都内嵌一份 src 模块快照，
# 且 scene/models 两份各自重复打包了 three.js；一改 src 即过期，故只留源文件（design/ 下的 html 与入口 .ts）
design/probe/*bundle.js
