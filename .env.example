# 前端构建时注入（pnpm build / vite 会读取）
# 存储后端 API 根路径。同源反代用默认 /api；前后端分开部署且不同域时填完整地址
VITE_API_BASE=/api

# 访问存储后端的 Bearer Token（与后端 AUTH_TOKEN 一致；后端未开启鉴权则留空）
VITE_API_TOKEN=

# —— 后端 node server/index.mjs ——
PORT=5174
# 数据目录（容器部署时挂持久卷）。默认 server/data
# DATA_DIR=/var/lib/scada/data
# 请求体上限（字节），默认 20971520 (20MB)
MAX_BODY_BYTES=20971520
# 允许的跨域来源，逗号分隔。默认 *（仅建议内网）；生产建议填前端站点
# 例: https://scada.example.com
CORS_ORIGIN=*
# 设置后启用 Bearer 鉴权，生产环境务必设置
# AUTH_TOKEN=change-me
