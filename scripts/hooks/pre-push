#!/bin/sh
# Git pre-push 钩子：推送前强制跑全量验证门槛（测试 + 类型 + 构建 + 行数）。
#
# 启用（每个克隆执行一次）：git config core.hooksPath scripts/hooks
# 临时绕过：git push --no-verify
#
# 为什么只做转发、逻辑放在 Node 脚本里：与 commit-msg 同一分工——壳只负责
# 定位与前置判断（如只推 tag 时放行），具体命令与失败处理见 pre-push-check.mjs。
# 本文件按自身路径定位校验脚本（不依赖仓库根位置），故 core.hooksPath 填相对或绝对路径都能工作。
set -u

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 0
checker="$hook_dir/../pre-push-check.mjs"

if [ ! -f "$checker" ]; then
  echo "[pre-push] 未找到 $checker，跳过全量验证" >&2
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] 未找到 node，跳过全量验证" >&2
  exit 0
fi

# 只推 tag 时跳过：tag 指向的提交已在随分支推送时过了门槛，重复跑没有意义。
# stdin 每行是 <local ref> <remote ref> <remote sha>，只在有非 tag 引用时才往下走。
only_tags=1
while read -r local_ref _remote_ref _sha; do
  case "$local_ref" in
    refs/tags/* | "") ;;
    *) only_tags=0; break ;;
  esac
done

if [ "$only_tags" -eq 1 ]; then
  echo "[pre-push] 本次只推 tag，跳过全量验证"
  exit 0
fi

exec node "$checker"
